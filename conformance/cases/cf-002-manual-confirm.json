      { "name": "stage.started", "t_ms": 7000, "stage_index": 1, "payload": { "stage_type": "rest", "duration_ms": 2000 } },
      { "name": "stage.countdown", "t_ms": 7000, "payload": { "second": 2 } },
      { "name": "stage.countdown", "t_ms": 8000, "payload": { "second": 1 } },
      { "name": "stage.finished", "t_ms": 9000, "stage_index": 1, "payload": { "reason": "timer_expired" } },
