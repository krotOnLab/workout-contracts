{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krotOnLab/workout-contracts/schema/workout.schema.json",
  "title": "Workout document",
  "description": "Пользовательский документ тренировки. Каноническое представление получается нормализацией (см. docs/protocol.md).",
  "type": "object",
  "required": ["schema_version", "workout"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "schema_version": { "const": 1 },
    "workout": { "$ref": "#/$defs/workout" },
    "runtime": { "$ref": "#/$defs/runtime" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "workout": {
      "type": "object",
      "required": ["workout_id", "name", "stages"],
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "workout_id": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/short_text" },
        "description": { "type": "string", "maxLength": 2000 },
        "countdown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 5
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/stage" }
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["type", "name", "completion"],
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "stage_id": { "$ref": "#/$defs/slug" },
        "type": { "enum": ["exercise", "rest"] },
        "name": { "$ref": "#/$defs/short_text" },
        "completion": { "enum": ["timed", "manual"] },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "description": { "type": "string", "maxLength": 2000 },
        "announcement_key": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "allow_skip": { "type": ["boolean", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "completion": { "const": "timed" } } },
          "then": { "required": ["duration_sec"] },
          "else": { "not": { "required": ["duration_sec"] } }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "description": "Настройки хоста. Не влияет на семантику этапов и не экспортируется на устройство.",
      "additionalProperties": true,
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyboard": { "type": "boolean", "default": true },
            "voice": { "type": "boolean", "default": false }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sound_effects": { "type": "boolean", "default": true },
            "tts": { "type": "boolean", "default": false },
            "music": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "enum": ["none", "external", "internal", "ducking"], "default": "none" }
              }
            }
          }
        },
        "announcements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["sound_only", "simple_speech", "phrase_speech"], "default": "sound_only" },
            "workout_start": { "type": "boolean", "default": true },
            "stage_start": { "type": "boolean", "default": true },
            "stage_end": { "type": "boolean", "default": true },
            "countdown": { "type": "boolean", "default": true },
            "workout_end": { "type": "boolean", "default": true }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow_next_on_timed": { "type": "boolean", "default": true },
            "allow_next_on_manual": { "type": "boolean", "default": false },
            "default_confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
            "stop_confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
            "debounce_ms": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 400 },
            "command_ttl_ms": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 1500 }
          }
        }
      }
    }
  }
}